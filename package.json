{
  "name": "istqb-tablet-app",
  "version": "1.0.2-dev",
  "private": true,
  "description": "Android wrapper project for the ISTQB FL tablet app.",
  "scripts": {
    "serve": "node local-server.js",
    "verify": "node scripts/verify.js",
    "cap:init": "npx cap init \"ISTQB FL\" \"com.local.istqbfl\" --web-dir www",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:release": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {}
}
