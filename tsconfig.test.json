{
  "extends": "./tsconfig.json",
  // middleware.ts는 운영 사이트 전체의 인증 관문인데, 앱 tsconfig의 include가 "src"뿐이라
  // 타입 검사를 한 번도 받지 않고 있었다(Vercel이 별도로 번들하므로 빌드에서도 안 걸린다).
  // 여기 넣어 최소한 `npm run typecheck:test`가 지나가게 한다.
  // scripts/의 유닛도 같은 이유로 여기 넣는다 — 데이터 보정 도구의 계약을 검사로
  // 고정해 두었는데, 그 검사 자체가 타입 검사를 못 받으면 조용히 썩는다.
  "include": ["src", "e2e", "middleware.ts", "middleware.test.ts", "scripts/**/*.test.ts"],
  "exclude": []
}
